// COLONNES CALCULÉES : Fact_ProjectPhase
// Créer les colonnes dans cette table, séparément, dans l’ordre indiqué
// Les colonnes de la source et les relations doivent déjà exister


Cost_Variance_Pct_Phase =
DIVIDE (
    Fact_ProjectPhase[Actual_Cost] - Fact_ProjectPhase[Planned_Cost],
    Fact_ProjectPhase[Planned_Cost]
)


Duration_Variance_Pct_Phase =
DIVIDE (
    Fact_ProjectPhase[Actual_Duration] - Fact_ProjectPhase[Planned_Duration],
    Fact_ProjectPhase[Planned_Duration]
)


Deliverable_Variance_Pct_Phase =
DIVIDE (
    Fact_ProjectPhase[Actual_Deliverables] - Fact_ProjectPhase[Planned_Deliverables],
    Fact_ProjectPhase[Planned_Deliverables]
)


Cost_Alert_Flag =
VAR PlannedCost =
    Fact_ProjectPhase[Planned_Cost]
VAR ActualCost =
    Fact_ProjectPhase[Actual_Cost]
RETURN
    IF (
        PlannedCost > 0
        && NOT ISBLANK (ActualCost)
        && DIVIDE (ActualCost - PlannedCost, PlannedCost) >= 15 / 100,
        1,
        0
    )


Duration_Alert_Flag =
VAR PlannedDuration =
    Fact_ProjectPhase[Planned_Duration]
VAR ActualDuration =
    Fact_ProjectPhase[Actual_Duration]
RETURN
    IF (
        PlannedDuration > 0
        && NOT ISBLANK (ActualDuration)
        && DIVIDE (
            ActualDuration - PlannedDuration,
            PlannedDuration
        ) >= 15 / 100,
        1,
        0
    )


Deliverable_Alert_Flag =
VAR PlannedDeliverables =
    Fact_ProjectPhase[Planned_Deliverables]
VAR ActualDeliverables =
    Fact_ProjectPhase[Actual_Deliverables]
RETURN
    IF (
        PlannedDeliverables > 0
        && NOT ISBLANK (ActualDeliverables)
        && DIVIDE (
            PlannedDeliverables - ActualDeliverables,
            PlannedDeliverables
        ) >= 15 / 100,
        1,
        0
    )


Alert_Count =
Fact_ProjectPhase[Cost_Alert_Flag]
+ Fact_ProjectPhase[Duration_Alert_Flag]
+ Fact_ProjectPhase[Deliverable_Alert_Flag]


Alert_Flag =
IF (
    Fact_ProjectPhase[Alert_Count] >= 1,
    1,
    0
)


Alert_Severity =
SWITCH (
    Fact_ProjectPhase[Alert_Count],
    3,
    "Critique",
    2,
    "Élevée",
    1,
    "À surveiller",
    "Conforme"
)


Deadline_Variance_Days_Phase =
VAR PlannedEndDate =
    Fact_ProjectPhase[Planned_End_Date]
VAR ActualEndDate =
    Fact_ProjectPhase[Actual_End_Date]
RETURN
    IF (
        NOT ISBLANK (PlannedEndDate)
        && NOT ISBLANK (ActualEndDate),
        DATEDIFF (
            PlannedEndDate,
            ActualEndDate,
            DAY
        ),
        BLANK ()
    )


Phase_Duration_Status =
VAR Planned =
    Fact_ProjectPhase[Planned_Duration]
VAR Actual =
    Fact_ProjectPhase[Actual_Duration]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK (Planned) || Planned <= 0 || ISBLANK (Actual) || Actual < 0,
        "Non évaluable",
        DIVIDE (Actual - Planned, Planned) >= 15 / 100,
        "Alerte",
        "Hors alerte"
    )


Phase_Cost_Status =
VAR Planned =
    Fact_ProjectPhase[Planned_Cost]
VAR Actual =
    Fact_ProjectPhase[Actual_Cost]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK (Planned) || Planned <= 0 || ISBLANK (Actual) || Actual < 0,
        "Non évaluable",
        DIVIDE (Actual - Planned, Planned) >= 15 / 100,
        "Alerte",
        "Hors alerte"
    )


Phase_Deliverable_Status =
VAR Planned =
    Fact_ProjectPhase[Planned_Deliverables]
VAR Actual =
    Fact_ProjectPhase[Actual_Deliverables]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK (Planned) || Planned <= 0 || ISBLANK (Actual) || Actual < 0,
        "Non évaluable",
        DIVIDE (Actual - Planned, Planned) <= -15 / 100,
        "Alerte",
        "Hors alerte"
    )