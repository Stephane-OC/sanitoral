// ============================================================================
// MESURES : Portefeuille et valeurs de référence
// TABLE   : _Measures
// OBJECTIF: Fournir les totaux réutilisés par les autres mesures et visuels
// CRÉATION: Sélectionner _Measures > Nouvelle mesure, puis créer chaque mesure
//           séparément
// ============================================================================


// Le DISTINCTCOUNT évite de compter plusieurs fois un projet possédant
// plusieurs phases
Total Projects =
DISTINCTCOUNT ( Fact_ProjectPhase[Project_ID] )


// La clé projet-phase est unique dans la table de faits
Total Phases =
DISTINCTCOUNT ( Fact_ProjectPhase[Project_Phase_Key] )


Planned Cost =
SUM ( Fact_ProjectPhase[Planned_Cost] )


Actual Cost =
SUM ( Fact_ProjectPhase[Actual_Cost] )


Planned Duration =
SUM ( Fact_ProjectPhase[Planned_Duration] )


Actual Duration =
SUM ( Fact_ProjectPhase[Actual_Duration] )


Planned Deliverables =
SUM ( Fact_ProjectPhase[Planned_Deliverables] )


Actual Deliverables =
SUM ( Fact_ProjectPhase[Actual_Deliverables] )


First Project Start Date =
MIN ( Fact_ProjectPhase[Start_Date] )


Last Planned End Date =
MAX ( Fact_ProjectPhase[Planned_End_Date] )


Last Actual End Date =
MAX ( Fact_ProjectPhase[Actual_End_Date] )