// ============================================================================
// MESURES : Alertes au niveau phase puis projet
// TABLE   : _Measures
// OBJECTIF: Compter les dérives sans compter plusieurs fois un même projet
// ============================================================================


Cost Alert Phases =
COALESCE (
    CALCULATE (
        [Total Phases],
        KEEPFILTERS (Fact_ProjectPhase[Cost_Alert_Flag] = 1)
    ),
    0
)


Duration Alert Phases =
COALESCE (
    CALCULATE (
        [Total Phases],
        KEEPFILTERS (Fact_ProjectPhase[Duration_Alert_Flag] = 1)
    ),
    0
)


Deliverable Alert Phases =
COALESCE (
    CALCULATE (
        [Total Phases],
        KEEPFILTERS (Fact_ProjectPhase[Deliverable_Alert_Flag] = 1)
    ),
    0
)


Alert Phases =
COALESCE (
    CALCULATE (
        [Total Phases],
        KEEPFILTERS (Fact_ProjectPhase[Alert_Flag] = 1)
    ),
    0
)


On Track Phases =
[Total Phases] - [Alert Phases]


Projects in Alert =
CALCULATE (
    [Total Projects],
    KEEPFILTERS (Dim_Project[Project_Duration_Status] = "Alerte")
)


Projects on Track =
CALCULATE (
    [Total Projects],
    KEEPFILTERS (Dim_Project[Project_Duration_Status] = "Hors alerte")
)


Alert Project Rate =
DIVIDE (
    [Projects in Alert],
    [Total Projects] - [Duration Unknown Projects]
)


Projects with Cost Alert =
CALCULATE (
    [Total Projects],
    KEEPFILTERS (Dim_Project[Project_Cost_Status] = "Alerte")
)


Projects with Duration Alert =
[Projects in Alert]


Projects with Deliverable Alert =
CALCULATE (
    [Total Projects],
    KEEPFILTERS (Dim_Project[Project_Deliverable_Status] = "Alerte")
)


Critical Alert Phases =
COALESCE (
    CALCULATE (
        [Total Phases],
        KEEPFILTERS (Fact_ProjectPhase[Alert_Count] = 3)
    ),
    0
)


High Alert Phases =
COALESCE (
    CALCULATE (
        [Total Phases],
        KEEPFILTERS (Fact_ProjectPhase[Alert_Count] = 2)
    ),
    0
)


Watch Alert Phases =
COALESCE (
    CALCULATE (
        [Total Phases],
        KEEPFILTERS (Fact_ProjectPhase[Alert_Count] = 1)
    ),
    0
)


Alert Color =
SWITCH (
    TRUE (),
    [Critical Alert Phases] > 0,
    "#FB7185",
    [High Alert Phases] > 0,
    "#FBBF24",
    [Watch Alert Phases] > 0,
    "#A78BFA",
    "#34D399"
)