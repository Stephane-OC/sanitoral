// ============================================================================
// MESURES : Alertes au niveau phase puis projet
// TABLE   : _Measures
// OBJECTIF: Compter les dérives sans compter plusieurs fois un même projet
// ============================================================================


Cost Alert Phases =
CALCULATE (
    [Total Phases],
    KEEPFILTERS ( Fact_ProjectPhase[Cost_Alert_Flag] = 1 )
)


Duration Alert Phases =
CALCULATE (
    [Total Phases],
    KEEPFILTERS ( Fact_ProjectPhase[Duration_Alert_Flag] = 1 )
)


Deliverable Alert Phases =
CALCULATE (
    [Total Phases],
    KEEPFILTERS ( Fact_ProjectPhase[Deliverable_Alert_Flag] = 1 )
)


Alert Phases =
CALCULATE (
    [Total Phases],
    KEEPFILTERS ( Fact_ProjectPhase[Alert_Flag] = 1 )
)


On Track Phases =
[Total Phases] - [Alert Phases]


// DISTINCTCOUNT est indispensable : un projet avec trois phases en alerte doit
// être compté une seule fois
Projects in Alert =
CALCULATE (
    DISTINCTCOUNT ( Fact_ProjectPhase[Project_ID] ),
    KEEPFILTERS ( Fact_ProjectPhase[Alert_Flag] = 1 )
)


Projects on Track =
[Total Projects] - [Projects in Alert]


Alert Project Rate =
DIVIDE ( [Projects in Alert], [Total Projects] )


Projects with Cost Alert =
CALCULATE (
    DISTINCTCOUNT ( Fact_ProjectPhase[Project_ID] ),
    KEEPFILTERS ( Fact_ProjectPhase[Cost_Alert_Flag] = 1 )
)


Projects with Duration Alert =
CALCULATE (
    DISTINCTCOUNT ( Fact_ProjectPhase[Project_ID] ),
    KEEPFILTERS ( Fact_ProjectPhase[Duration_Alert_Flag] = 1 )
)


Projects with Deliverable Alert =
CALCULATE (
    DISTINCTCOUNT ( Fact_ProjectPhase[Project_ID] ),
    KEEPFILTERS ( Fact_ProjectPhase[Deliverable_Alert_Flag] = 1 )
)


Critical Alert Phases =
CALCULATE (
    [Total Phases],
    KEEPFILTERS ( Fact_ProjectPhase[Alert_Count] = 3 )
)


High Alert Phases =
CALCULATE (
    [Total Phases],
    KEEPFILTERS ( Fact_ProjectPhase[Alert_Count] = 2 )
)


Watch Alert Phases =
CALCULATE (
    [Total Phases],
    KEEPFILTERS ( Fact_ProjectPhase[Alert_Count] = 1 )
)


// Couleur réutilisable dans la mise en forme conditionnelle des cartes,
// tableaux et indicateurs. La couleur correspond à l'alerte la plus grave du
// contexte affiché
Alert Color =
SWITCH (
    TRUE (),
    [Critical Alert Phases] > 0, "#FB7185",
    [High Alert Phases] > 0, "#FBBF24",
    [Watch Alert Phases] > 0, "#A78BFA",
    "#34D399"
)