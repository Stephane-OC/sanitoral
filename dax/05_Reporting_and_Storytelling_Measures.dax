// ============================================================================
// MESURES : Titres, contexte et storytelling
// TABLE   : _Measures
// OBJECTIF: Rendre les pages compréhensibles quel que soit le rôle ou le filtre
// ============================================================================


Selected Scope =
VAR P =
    SELECTEDVALUE (Dim_Project[Project_Label])
VAR C =
    SELECTEDVALUE (Dim_Project[Country])
VAR R =
    SELECTEDVALUE (Dim_Project[Region])
RETURN
    SWITCH (
        TRUE (),
        NOT ISBLANK (P),
        "Projet : " & P,
        NOT ISBLANK (C),
        "Pays : " & C,
        NOT ISBLANK (R),
        "Région : " & R,
        "Monde"
    )


Visible Scope Level =
SWITCH (
    TRUE (),
    HASONEVALUE (Dim_Project[Country]),
    "Vue pays",
    HASONEVALUE (Dim_Project[Region]),
    "Vue régionale",
    "Vue mondiale"
)


Selected Project =
SELECTEDVALUE (
    Dim_Project[Project_Label],
    "Tous les projets"
)


Data Period =
VAR StartDate = [First Project Start Date]
VAR EndDate = [Last Actual End Date]
RETURN
    IF (
        ISBLANK (StartDate) || ISBLANK (EndDate),
        "Période indisponible",
        FORMAT (StartDate, "dd / MM / yyyy")
        & " – "
        & FORMAT (EndDate, "dd / MM / yyyy")
    )


Executive Narrative =
VAR Assessed = [Total Projects] - [Duration Unknown Projects]
RETURN
    FORMAT ([Projects in Alert], "0") & " projet(s) en alerte de durée cumulée sur "
    & FORMAT (Assessed, "0") & " évaluables, soit "
    & FORMAT ([Alert Project Rate], "0.0 %") & ". "
    & FORMAT ([Overall Alert Projects], "0")
    & " projet(s) présentent au moins un écart global défavorable de 15 % ou plus."


Performance Narrative =
VAR CostVariance = [Cost Variance %]
VAR DurationVariance = [Duration Variance %]
VAR DeliverableVariance = [Deliverable Variance %]
RETURN
    "Écart coût : "
    & FORMAT (CostVariance, "+0.0 %;-0.0 %;0.0 %")
    & " • écart durée : "
    & FORMAT (DurationVariance, "+0.0 %;-0.0 %;0.0 %")
    & " • écart livrables : "
    & FORMAT (DeliverableVariance, "+0.0 %;-0.0 %;0.0 %")


Selected Project Alert Summary =
IF (
    [Project Detail Available] <> 1,
    "Sélectionnez un projet puis cliquez sur Voir le détail.",
    [Selected Project] & " : " & [Project Duration Status]
    & " sur la durée cumulée ("
        & FORMAT ([Project Duration Variance %], "+0.0%;-0.0%;0.0%") & "). "
    & FORMAT ([Duration Alert Phases], "0")
    & " phase(s) atteignent le seuil de durée."
)