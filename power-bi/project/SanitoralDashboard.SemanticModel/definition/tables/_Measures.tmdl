table _Measures
	lineageTag: a73c7191-0693-4f1f-9026-9c37cb6bc7de

	measure 'Total Projects' =
			COALESCE (
			    CALCULATE (
			        DISTINCTCOUNT ( Dim_Project[Project_ID] ),
			        KEEPFILTERS ( Dim_Project[Project_Phase_Count] > 0 ),
			        KEEPFILTERS ( NOT ISBLANK ( Dim_Project[Project_ID] ) )
			    ), 0
			)
		formatString: 0
		displayFolder: Présentation
		lineageTag: 5a968906-788b-4ce9-8a80-b8db4d57ded4

	measure 'Total Phases' =
			
			DISTINCTCOUNT ( Fact_ProjectPhase[Project_Phase_Key] )
		formatString: 0
		displayFolder: Présentation
		lineageTag: b992bda7-17e5-4579-9a8c-f9763cde0354

	measure 'Planned Cost' =
			
			SUM ( Fact_ProjectPhase[Planned_Cost] )
		formatString: #,0
		lineageTag: 8c9516df-a9a8-4b23-8fd3-d9dcd7c40b95

	measure 'Actual Cost' =
			
			SUM ( Fact_ProjectPhase[Actual_Cost] )
		formatString: #,0
		lineageTag: 6cb3e9c1-b10a-49b2-b794-4cab7fc55899

	measure 'Planned Duration' =
			
			SUM ( Fact_ProjectPhase[Planned_Duration] )
		formatString: 0
		lineageTag: a0aa9e24-159d-44af-8ad7-91051f4f0972

	measure 'Actual Duration' =
			
			SUM ( Fact_ProjectPhase[Actual_Duration] )
		formatString: 0
		lineageTag: 15d5ace2-f341-43d6-89bb-53e3473ce7e6

	measure 'Planned Deliverables' =
			
			SUM ( Fact_ProjectPhase[Planned_Deliverables] )
		formatString: 0
		lineageTag: 4877c986-d43e-4d9c-a89e-9baa1c0a1f41

	measure 'Actual Deliverables' =
			
			SUM ( Fact_ProjectPhase[Actual_Deliverables] )
		formatString: 0
		lineageTag: 5ed393c5-c884-475a-bce1-ac2440603f24

	measure 'First Project Start Date' =
			
			MIN ( Fact_ProjectPhase[Start_Date] )
		formatString: General Date
		lineageTag: be103875-817f-4c17-b77d-211e809fb338

	measure 'Last Planned End Date' =
			
			MAX ( Fact_ProjectPhase[Planned_End_Date] )
		formatString: General Date
		lineageTag: 6051026c-eb3a-4f7e-96a0-270a8ff3f530

	measure 'Last Actual End Date' = ```
			
			MAX ( Fact_ProjectPhase[Actual_End_Date] )
			
			```
		formatString: General Date
		lineageTag: ceb10f7b-4fac-400e-9b86-d6c7f574f510

	measure 'Cost Variance' =
			
			[Actual Cost] - [Planned Cost]
		formatString: #,0
		lineageTag: 64ec0d17-c399-4a3c-84c5-b961a4fb89a2

	measure 'Cost Variance %' =
			
			DIVIDE ( [Cost Variance], [Planned Cost] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: db9310f1-a8d5-4d49-ad8f-347f8e21fd0c

	measure 'Cost Performance Status' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Planned Cost] ), BLANK (),
			    [Cost Variance %] >= 15 / 100, "Alerte",
			    [Cost Variance %] > 0, "Dépassement inférieur à 15 %",
			    "Conforme"
			)
		lineageTag: 0bf5a485-cf23-4d3a-b744-725046713b2b

	measure 'Duration Variance' =
			
			[Actual Duration] - [Planned Duration]
		formatString: 0
		lineageTag: 0588be4d-5535-4fe0-b33a-4637eb120f39

	measure 'Duration Variance %' =
			
			DIVIDE ( [Duration Variance], [Planned Duration] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: c1880670-e995-404c-8c25-ca9d55465bce

	measure 'Duration Performance Status' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Planned Duration] ), BLANK (),
			    [Duration Variance %] >= 15 / 100, "Alerte",
			    [Duration Variance %] > 0, "Retard inférieur à 15 %",
			    "Conforme"
			)
		lineageTag: 2b9f036b-7681-4830-9d04-10a030a168e6

	measure 'Deliverable Variance' =
			
			[Actual Deliverables] - [Planned Deliverables]
		formatString: 0
		lineageTag: 526284d3-9d8a-40c9-9b14-4b73d186177b

	measure 'Deliverable Variance %' =
			
			DIVIDE ( [Deliverable Variance], [Planned Deliverables] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: fd096aa2-97c9-4686-9610-ea1d2d5940ba

	measure 'Deliverable Completion Rate' =
			
			DIVIDE ( [Actual Deliverables], [Planned Deliverables] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 7b3bef32-0faa-4b91-9b5d-be747bf95471

	measure 'Deliverable Performance Status' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Planned Deliverables] ), BLANK (),
			    [Deliverable Variance %] <= -15 / 100, "Alerte",
			    [Deliverable Variance %] < 0, "Manque inférieur à 15 %",
			    "Conforme"
			)
		lineageTag: 5fea718a-d992-46f4-b436-7cb048561195

	measure 'Cost Alert Phases' =
			COALESCE (
			    CALCULATE (
			        [Total Phases],
			        KEEPFILTERS ( Fact_ProjectPhase[Cost_Alert_Flag] = 1 )
			    ),
			    0
			)
		formatString: 0
		lineageTag: 2f5adecb-68df-4434-adb7-3869f736aa65

	measure 'Duration Alert Phases' =
			COALESCE (
			CALCULATE (
						    [Total Phases],
						    KEEPFILTERS ( Fact_ProjectPhase[Duration_Alert_Flag] = 1 )
						)
			, 0 )
		formatString: 0
		lineageTag: 373aabf1-c742-46ff-be5e-a5a7c6bc7674

	measure 'Deliverable Alert Phases' =
			COALESCE (
			CALCULATE (
						    [Total Phases],
						    KEEPFILTERS ( Fact_ProjectPhase[Deliverable_Alert_Flag] = 1 )
						)
			, 0 )
		formatString: 0
		lineageTag: a059ab98-6f1e-411d-b6bb-2031efbbe2f5

	measure 'Alert Phases' =
			COALESCE (
			CALCULATE (
						    [Total Phases],
						    KEEPFILTERS ( Fact_ProjectPhase[Alert_Flag] = 1 )
						)
			, 0 )
		formatString: 0
		lineageTag: bf9ca91d-13b7-45e1-9e79-9b9fee4f5069

	measure 'On Track Phases' =
			
			[Total Phases] - [Alert Phases]
		formatString: 0
		lineageTag: 6938bb3b-5e16-45fd-9eb3-1855130dc427

	measure 'Projects in Alert' =
			CALCULATE (
			    [Total Projects],
			    KEEPFILTERS ( Dim_Project[Project_Duration_Status] = "Alerte" )
			)
		formatString: 0
		displayFolder: Présentation
		lineageTag: a0c94fec-8769-41bb-adb0-8ffaca5e4b90

	measure 'Projects on Track' =
			CALCULATE (
			    [Total Projects],
			    KEEPFILTERS ( Dim_Project[Project_Duration_Status] = "Hors alerte" )
			)
		formatString: 0
		displayFolder: Présentation
		lineageTag: c6fc8180-4a7b-480a-913d-c52fd0f0075c

	measure 'Alert Project Rate' =
			DIVIDE (
			    [Projects in Alert],
			    [Total Projects] - [Duration Unknown Projects]
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: b994cc74-829d-4bc7-a63b-da5c3a253243

	measure 'Projects with Cost Alert' =
			CALCULATE (
			    [Total Projects],
			    KEEPFILTERS ( Dim_Project[Project_Cost_Status] = "Alerte" )
			)
		formatString: 0
		displayFolder: Présentation
		lineageTag: 43c4da22-a076-430b-bedc-ad63d9156467

	measure 'Projects with Duration Alert' = [Projects in Alert]
		formatString: 0
		displayFolder: Présentation
		lineageTag: d0f2599e-25a4-42ce-a3ff-ad87d94c7091

	measure 'Projects with Deliverable Alert' =
			CALCULATE (
			    [Total Projects],
			    KEEPFILTERS ( Dim_Project[Project_Deliverable_Status] = "Alerte" )
			)
		formatString: 0
		displayFolder: Présentation
		lineageTag: 697c13a2-834b-4db9-a24a-2a8fe8e65b41

	measure 'Critical Alert Phases' =
			COALESCE (
			CALCULATE (
						    [Total Phases],
						    KEEPFILTERS ( Fact_ProjectPhase[Alert_Count] = 3 )
						)
			, 0 )
		formatString: 0
		lineageTag: 6682a831-a42e-4c6b-9e3d-318fc6da6f2b

	measure 'High Alert Phases' =
			COALESCE (
			CALCULATE (
						    [Total Phases],
						    KEEPFILTERS ( Fact_ProjectPhase[Alert_Count] = 2 )
						)
			, 0 )
		formatString: 0
		lineageTag: 5bb757b0-e918-4a89-9ba9-018ede3835aa

	measure 'Watch Alert Phases' =
			COALESCE (
			CALCULATE (
						    [Total Phases],
						    KEEPFILTERS ( Fact_ProjectPhase[Alert_Count] = 1 )
						)
			, 0 )
		formatString: 0
		displayFolder: Présentation
		lineageTag: d4d22f0f-d405-4a1d-8f78-a7def695313e

	measure 'Alert Color' =
			
			SWITCH (
			    TRUE (),
			    [Critical Alert Phases] > 0, "#FB7185",
			    [High Alert Phases] > 0, "#FBBF24",
			    [Watch Alert Phases] > 0, "#A78BFA",
			    "#34D399"
			)
		lineageTag: 39e94ed0-e78f-476a-8186-644dac2250ac

	measure 'Selected Scope' =
			VAR P = SELECTEDVALUE ( Dim_Project[Project_Label] )
			VAR C = SELECTEDVALUE ( Dim_Project[Country] )
			VAR R = SELECTEDVALUE ( Dim_Project[Region] )
			RETURN SWITCH ( TRUE (), NOT ISBLANK ( P ), "Projet : " & P, NOT ISBLANK ( C ), "Pays : " & C, NOT ISBLANK ( R ), "Région : " & R, "Monde" )
		displayFolder: Présentation
		lineageTag: 4f3c101b-d26b-4182-b55c-ad156cfa9d1a

	measure 'Visible Scope Level' =
			
			SWITCH (
			    TRUE (),
			    HASONEVALUE ( Dim_Project[Country] ), "Vue pays",
			    HASONEVALUE ( Dim_Project[Region] ), "Vue régionale",
			    "Vue mondiale"
			)
		displayFolder: Présentation
		lineageTag: 8febeea9-850d-4269-8ce4-2c39ef6041c5

	measure 'Selected Project' =
			
			SELECTEDVALUE ( Dim_Project[Project_Label], "Tous les projets" )
		displayFolder: Présentation
		lineageTag: 273e3718-52a2-4f94-b3dd-7d91272e3d18

	measure 'Data Period' =
			
			VAR StartDate = [First Project Start Date]
			VAR EndDate = [Last Actual End Date]
			RETURN
			    IF (
			        ISBLANK ( StartDate ) || ISBLANK ( EndDate ),
			        "Période indisponible",
			        FORMAT ( StartDate, "dd/MM/yyyy" )
			            & " – "
			            & FORMAT ( EndDate, "dd/MM/yyyy" )
			    )
		lineageTag: 7235f528-7ed5-4367-b0c9-02c315cd81a8

	measure 'Executive Narrative' =
			VAR Assessed = [Total Projects] - [Duration Unknown Projects]
			RETURN
			    FORMAT ( [Projects in Alert], "0" ) & " projet(s) en alerte de durée cumulée sur "
			        & FORMAT ( Assessed, "0" ) & " évaluables, soit "
			        & FORMAT ( [Alert Project Rate], "0.0 %" ) & ". "
			        & FORMAT ( [Overall Alert Projects], "0" )
			        & " projet(s) présentent au moins un écart global défavorable de 15 % ou plus."
		lineageTag: 694aa99a-0a37-43e2-9b41-cb188ecb5582

	measure 'Performance Narrative' =
			
			VAR CostVariance = [Cost Variance %]
			VAR DurationVariance = [Duration Variance %]
			VAR DeliverableVariance = [Deliverable Variance %]
			RETURN
			    "Écart coût : "
			        & FORMAT ( CostVariance, "+0.0 %;-0.0 %;0.0 %" )
			        & " • écart durée : "
			        & FORMAT ( DurationVariance, "+0.0 %;-0.0 %;0.0 %" )
			        & " • écart livrables : "
			        & FORMAT ( DeliverableVariance, "+0.0 %;-0.0 %;0.0 %" )
		lineageTag: 45da29dc-9ba9-4ecd-b602-fcb47c64ced4

	measure 'Selected Project Alert Summary' =
			IF (
			    [Project Detail Available] <> 1,
			    "Sélectionnez un projet puis cliquez sur Voir le détail.",
			    [Selected Project] & " : " & [Project Duration Status]
			        & " sur la durée cumulée ("
			        & FORMAT ( [Project Duration Variance %], "+0.0%;-0.0%;0.0%" ) & "). "
			        & FORMAT ( [Duration Alert Phases], "0" )
			        & " phase(s) atteignent le seuil de durée."
			)
		displayFolder: Présentation
		lineageTag: 5493dd39-61e2-47fe-974e-5145c74a158c

	measure 'Late Phases' =
			COALESCE (
			CALCULATE (
						    [Total Phases],
						    KEEPFILTERS ( Fact_ProjectPhase[Deadline_Variance_Days_Phase] > 0 )
						)
			, 0 )
		formatString: 0
		lineageTag: 9950dc57-6f12-4de0-be18-f43c2a2872fa

	measure 'Early Phases' =
			COALESCE (
			CALCULATE (
						    [Total Phases],
						    KEEPFILTERS ( Fact_ProjectPhase[Deadline_Variance_Days_Phase] < 0 )
						)
			, 0 )
		formatString: 0
		lineageTag: be7127a1-4613-4516-9cd3-75ee44ad0f4c

	measure 'On Time Deadline Phases' =
			CALCULATE (
			    [Total Phases],
			    KEEPFILTERS (
			        FILTER (
			            Fact_ProjectPhase,
			            NOT ISBLANK ( Fact_ProjectPhase[Deadline_Variance_Days_Phase] )
			                && Fact_ProjectPhase[Deadline_Variance_Days_Phase] == 0
			        )
			    )
			)
		formatString: 0
		lineageTag: 6598336b-130a-4a6d-9b78-c0dc1a46dff9

	measure 'Late Phase Rate' =
			
			DIVIDE ( [Late Phases], [Total Phases] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: aab20972-f36f-4ce5-919f-025644417247

	measure 'Average Delay Days' =
			
			AVERAGEX (
			    FILTER (
			        Fact_ProjectPhase,
			        Fact_ProjectPhase[Deadline_Variance_Days_Phase] > 0
			    ),
			    Fact_ProjectPhase[Deadline_Variance_Days_Phase]
			)
		formatString: 0.0
		lineageTag: 7191b254-f560-4e2e-8d0a-adf99717c859

	measure 'Average Advance Days' =
			
			AVERAGEX (
			    FILTER (
			        Fact_ProjectPhase,
			        Fact_ProjectPhase[Deadline_Variance_Days_Phase] < 0
			    ),
			    ABS ( Fact_ProjectPhase[Deadline_Variance_Days_Phase] )
			)
		formatString: 0.0
		lineageTag: c35ff9cf-2980-475c-aee5-5d8e40711013

	measure 'Delay Exposure Days' =
			
			DIVIDE (
			    CALCULATE (
			        SUM ( Fact_ProjectPhase[Deadline_Variance_Days_Phase] ),
			        KEEPFILTERS ( Fact_ProjectPhase[Deadline_Variance_Days_Phase] > 0 )
			    ),
			    [Total Phases]
			)
		formatString: 0.0
		lineageTag: 2117f072-53fa-40a2-83f7-f2dea4de321b

	measure 'Advance Exposure Days' =
			
			DIVIDE (
			    - CALCULATE (
			        SUM ( Fact_ProjectPhase[Deadline_Variance_Days_Phase] ),
			        KEEPFILTERS ( Fact_ProjectPhase[Deadline_Variance_Days_Phase] < 0 )
			    ),
			    [Total Phases]
			)
		formatString: 0.0
		lineageTag: bd52eb64-40a3-4147-b506-af150647fd7b

	measure 'Country Late Phases' =
			
			CALCULATE (
			    [Late Phases],
			    REMOVEFILTERS ( Dim_Project[Project_ID], Dim_Project[Project_Label] )
			)
		formatString: 0
		lineageTag: bddd8512-abfd-419c-9135-a30a4a744951

	measure 'Country Early Phases' =
			
			CALCULATE (
			    [Early Phases],
			    REMOVEFILTERS ( Dim_Project[Project_ID], Dim_Project[Project_Label] )
			)
		formatString: 0
		lineageTag: f5cd66b5-04ee-4afb-b8f1-f62275563ec1

	measure 'Country Late Phase Rate' =
			
			CALCULATE (
			    [Late Phase Rate],
			    REMOVEFILTERS ( Dim_Project[Project_ID], Dim_Project[Project_Label] )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 07dcb0b1-6db2-4cf4-82d6-c5782e87af5f

	measure 'Country Average Delay Days' =
			
			CALCULATE (
			    [Average Delay Days],
			    REMOVEFILTERS ( Dim_Project[Project_ID], Dim_Project[Project_Label] )
			)
		formatString: 0.0
		lineageTag: d373aa4d-c1a2-41a3-b79e-feb62a43d176

	measure 'Country Average Advance Days' =
			
			CALCULATE (
			    [Average Advance Days],
			    REMOVEFILTERS ( Dim_Project[Project_ID], Dim_Project[Project_Label] )
			)
		formatString: 0.0
		lineageTag: e55cc233-34ef-4e7d-b659-04f3040e2740

	measure 'Country Delay Exposure Days' =
			
			CALCULATE (
			    [Delay Exposure Days],
			    REMOVEFILTERS ( Dim_Project[Project_ID], Dim_Project[Project_Label] )
			)
		formatString: 0.0
		lineageTag: db9aab07-d593-474b-bd74-9e4322f32949

	measure 'Country Advance Exposure Days' =
			
			CALCULATE (
			    [Advance Exposure Days],
			    REMOVEFILTERS ( Dim_Project[Project_ID], Dim_Project[Project_Label] )
			)
		formatString: 0.0
		lineageTag: 0e7da5ef-a5f1-41ba-8844-3a541f55bc34

	measure 'Countries Analyzed' =
			
			CALCULATE (
			    DISTINCTCOUNT ( Dim_Project[Country] ),
			    REMOVEFILTERS ( Dim_Project[Project_ID], Dim_Project[Project_Label] )
			)
		formatString: 0
		lineageTag: 7c9736b5-0857-4e06-91a2-b4a48aca1bed

	measure 'Most Delayed Country' =
			
			VAR CountriesInScope =
			    CALCULATETABLE (
			        VALUES ( Dim_Project[Country] ),
			        REMOVEFILTERS ( Dim_Project[Project_ID], Dim_Project[Project_Label] )
			    )
			VAR RankedCountries =
			    TOPN (
			        1,
			        ADDCOLUMNS (
			            CountriesInScope,
			            "@Exposure", [Country Delay Exposure Days]
			        ),
			        [@Exposure], DESC,
			        Dim_Project[Country], ASC
			    )
			RETURN
			    CONCATENATEX (
			        RankedCountries,
			        Dim_Project[Country] & " • " & FORMAT ( [@Exposure], "0.0" ) & " j"
			    )
		lineageTag: 834cd9c8-e390-427a-817c-8265242a2f35

	measure 'Most Advanced Country' =
			
			VAR CountriesInScope =
			    CALCULATETABLE (
			        VALUES ( Dim_Project[Country] ),
			        REMOVEFILTERS ( Dim_Project[Project_ID], Dim_Project[Project_Label] )
			    )
			VAR RankedCountries =
			    TOPN (
			        1,
			        ADDCOLUMNS (
			            CountriesInScope,
			            "@Exposure", [Country Advance Exposure Days]
			        ),
			        [@Exposure], DESC,
			        Dim_Project[Country], ASC
			    )
			RETURN
			    CONCATENATEX (
			        RankedCountries,
			        Dim_Project[Country] & " • " & FORMAT ( [@Exposure], "0.0" ) & " j"
			    )
		lineageTag: 279ba45f-0de9-49c6-bfff-59e646f80765

	measure 'Selected Project Context' =
			
			VAR ProjectName = [Selected Project]
			VAR CountryName = SELECTEDVALUE ( Dim_Project[Country] )
			VAR RegionName = SELECTEDVALUE ( Dim_Project[Region] )
			VAR ProjectType = SELECTEDVALUE ( Dim_Project[Project_Type] )
			RETURN
			    IF (
			        ProjectName = "Tous les projets",
			        "Sélectionnez un projet dans la liste",
			        ProjectName & " • " & CountryName & " • " & RegionName & " • " & ProjectType
			    )
		displayFolder: Présentation
		lineageTag: 1b5c42e3-096f-419c-8375-d83206c7088d

	measure 'Selected Project Detail Narrative' =
			IF (
			    [Project Detail Available] <> 1,
			    "Ouvrez cette page avec Voir le détail depuis une ligne de projet.",
			    [Selected Project] & " (" & SELECTEDVALUE ( Dim_Project[Country] ) & ") : "
			        & [Project Duration Status] & " sur la durée cumulée, écart "
			        & FORMAT ( [Project Duration Variance %], "+0.0%;-0.0%;0.0%" ) & ". "
			        & FORMAT ( [Duration Alert Phases], "0" )
			        & " phase(s) atteignent le seuil ; les autres phases peuvent compenser leur retard."
			)
		displayFolder: Présentation
		lineageTag: 8dd3478e-5b82-4e24-9c31-b876c7c7c741

	measure 'Selected Country Delay Rank' =
			
			VAR SelectedCountry = SELECTEDVALUE ( Dim_Project[Country] )
			VAR CountriesInScope =
			    CALCULATETABLE (
			        VALUES ( Dim_Project[Country] ),
			        REMOVEFILTERS ( Dim_Project[Project_ID], Dim_Project[Project_Label] )
			    )
			VAR CurrentExposure =
			    CALCULATE (
			        [Country Delay Exposure Days],
			        REMOVEFILTERS ( Dim_Project[Project_ID], Dim_Project[Project_Label] ),
			        Dim_Project[Country] = SelectedCountry
			    )
			RETURN
			    IF (
			        ISBLANK ( SelectedCountry ),
			        BLANK (),
			        RANKX (
			            CountriesInScope,
			            [Country Delay Exposure Days],
			            CurrentExposure,
			            DESC,
			            DENSE
			        )
			    )
		formatString: 0
		displayFolder: Présentation
		lineageTag: 819cd583-62b4-4460-b8d2-b00c38585ed7

	measure 'Selected Country Rank Label' =
			
			VAR CountryName = SELECTEDVALUE ( Dim_Project[Country] )
			VAR CountryRank = [Selected Country Delay Rank]
			RETURN
			    IF (
			        ISBLANK ( CountryName ),
			        "Sélectionnez un projet",
			        CountryName
			            & " • rang retard "
			            & FORMAT ( CountryRank, "0" )
			            & " / "
			            & FORMAT ( [Countries Analyzed], "0" )
			    )
		displayFolder: Présentation
		lineageTag: 37812d76-471e-41dc-bb42-4480aadeb7c2

	measure 'Duration Unknown Projects' = CALCULATE ( [Total Projects], KEEPFILTERS ( Dim_Project[Project_Duration_Status] = "Non évaluable" ) )
		formatString: 0
		lineageTag: 043de207-ec03-4ca6-8df2-284c0fa66df3

	measure 'Overall Alert Projects' = CALCULATE ( [Total Projects], KEEPFILTERS ( Dim_Project[Project_Alert_Status] = "Alerte" ) )
		formatString: 0
		lineageTag: 79662f89-1caa-4fcf-9f63-c072fb1683a8

	measure 'Overall On Track Projects' = CALCULATE ( [Total Projects], KEEPFILTERS ( Dim_Project[Project_Alert_Status] = "Hors alerte" ) )
		formatString: 0
