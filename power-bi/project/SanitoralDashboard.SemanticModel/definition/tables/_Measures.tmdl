		summarizeBy: sum
		isNameInferred
		sourceColumn: [_Placeholder]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source =
				
				ROW (
				    "_Placeholder",
				    BLANK ()
				)

	annotation PBI_Id = be107d77f1f440988293b4c03d1d2216

