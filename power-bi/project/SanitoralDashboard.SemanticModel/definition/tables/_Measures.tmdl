	measure 'Project Deliverable Color' = SWITCH ( [Project Deliverable Status], "Alerte", "#FB7185", "Hors alerte", "#34D399", "#94A3B8" )
		displayFolder: Présentation
		lineageTag: 8bbfd42e-e469-4b2f-b8cf-84954d1622ba

	measure 'Country Duration Status' =
			SWITCH ( TRUE (),
			    [Total Projects] = 0, BLANK (),
			    [Projects in Alert] > 0, "Au moins un projet en alerte de durée",
			    [Duration Unknown Projects] > 0, "Données incomplètes",
			    "Aucun projet en alerte de durée"
			)
		lineageTag: 82b450c9-e00d-4e55-b716-59490fa34fc6

	measure 'Country Duration Color' =
			SWITCH ( TRUE (),
			    [Total Projects] = 0, "#94A3B8",
			    [Projects in Alert] > 0, "#FB7185",
			    [Duration Unknown Projects] > 0, "#94A3B8",
			    "#34D399"
			)
		lineageTag: ed54be8c-7547-4ded-a6aa-68baf417bfb3

	measure 'Portfolio Countries' =
			COALESCE ( COUNTROWS (
			    FILTER ( VALUES ( Dim_Project[Country] ),
			        NOT ISBLANK ( Dim_Project[Country] ) && [Total Projects] > 0
			    )
			), 0 )
		formatString: 0
		lineageTag: 6fedbca3-95ca-46a6-a89f-93911fe8f73b

	measure 'Max Project Duration Variance %' =
			MAXX (
			    FILTER ( VALUES ( Dim_Project[Project_ID] ), [Total Projects] > 0 ),
			    [Project Duration Variance %]
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: ee40d267-cf24-4b2f-9af0-61da2896c5d9

	measure 'Project Detail Available' =
			
			IF (
			    HASONEVALUE ( Dim_Project[Project_ID] )
			        && [Total Projects] = 1,
			    1,
			    0
			)
		formatString: 0
		displayFolder: Présentation
		lineageTag: 94c57198-d63e-4e21-b12b-6d681c1b73da

	measure 'Project Detail Instruction' =
			IF ( [Project Detail Available] = 1,
			    "Voir les phases du projet sélectionné",
			    "Sélectionnez un seul projet puis cliquez sur Voir le détail."
			)
		displayFolder: Présentation
		lineageTag: a1b7b128-d9fb-46a7-8946-b49cbb2fca44

	measure 'Detail Planned Cost' =
			
			IF (
			    [Project Detail Available] = 1,
			    COALESCE ( [Planned Cost], 0 )
			)
		formatString: #,0
		displayFolder: Pilotage
		lineageTag: 1f400f43-7c3c-49e3-bd88-a460261e7fcf

	measure 'Detail Project Context' = IF ( [Project Detail Available] = 1, [Selected Project] & "   •   " & SELECTEDVALUE ( Dim_Project[Country] ) & "   •   " & SELECTEDVALUE ( Dim_Project[Region] ) & "   •   " & SELECTEDVALUE ( Dim_Project[Project_Type] ), "Sélectionnez un projet dans la liste, ou ouvrez sa fiche depuis un tableau." )
		displayFolder: Pilotage
		lineageTag: b5816e99-ce88-4820-9b99-a6b4234ca4a9

	measure 'Detail Actual Cost' = IF ( [Project Detail Available] = 1, COALESCE ( [Actual Cost], 0 ) )
		formatString: #,0
		displayFolder: Pilotage
		lineageTag: dd418694-f16c-4d98-93ff-c575da0e32a4

	measure 'Detail Planned Duration' = IF ( [Project Detail Available] = 1, COALESCE ( [Planned Duration], 0 ) )
		formatString: 0" j"
		displayFolder: Pilotage
		lineageTag: fa3efe9f-feb3-4acd-9fee-910d411bd7bb

	measure 'Detail Actual Duration' = IF ( [Project Detail Available] = 1, COALESCE ( [Actual Duration], 0 ) )
		formatString: 0" j"
