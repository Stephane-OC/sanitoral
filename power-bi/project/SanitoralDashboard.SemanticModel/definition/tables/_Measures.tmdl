	measure 'Planning Summary' = FORMAT ( [Total Projects], "0" ) & " projets dans le périmètre • " & FORMAT ( [Projects in Alert], "0" ) & " en alerte de durée cumulée. Sélectionnez une barre ou une ligne, puis ouvrez la fiche projet."
		displayFolder: Pilotage
		lineageTag: a837dbb7-43ea-46a2-8b01-e81776ed189d

	measure 'Alert Page Summary' = FORMAT ( [Overall Alert Projects], "0" ) & " projets avec au moins une alerte cumulée. " & FORMAT ( COALESCE ( [Alert Phases], 0 ), "0" ) & " phases en alerte dans la période affichée. Une phase peut cumuler plusieurs types d’alerte."
		displayFolder: Pilotage
		lineageTag: 41cbb945-b39d-4c25-963f-1b9aa5636b86

	measure 'Detail Actual Deliverables' = IF ( [Project Detail Available] = 1, COALESCE ( [Actual Deliverables], 0 ) )
