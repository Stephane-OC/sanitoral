	measure 'Overall Unknown Projects' = CALCULATE ( [Total Projects], KEEPFILTERS ( Dim_Project[Project_Alert_Status] = "Non évaluable" ) )
		formatString: 0
		lineageTag: b65b7147-4f6d-4dfa-b6d9-beea01e1cfbc

	measure 'Overall Alert Project Rate' = DIVIDE ( [Overall Alert Projects], [Overall Alert Projects] + [Overall On Track Projects] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: d9fdc894-44eb-4033-bbe7-a29d0aec91cd

	measure 'Project Duration Variance %' = IF ( HASONEVALUE ( Dim_Project[Project_ID] ), SELECTEDVALUE ( Dim_Project[Project_Duration_Variance_Pct] ) )
