		lineageTag: 3f5b9cba-fe5c-4ea9-af3f-ed5f0e6b724b

	measure 'Detail Late Phases' = IF ( [Project Detail Available] = 1, COALESCE ( [Late Phases], 0 ) )
		formatString: 0
		displayFolder: Pilotage
		lineageTag: 9480d940-7920-4421-adee-d60312a0aec9

	measure 'Detail Summary' =
			IF ( [Project Detail Available] <> 1,
			"La fiche reste vide tant qu’un seul projet n’est pas sélectionné.",
			FORMAT ( COALESCE ( [Late Phases], 0 ), "0" ) & " phases avec une fin décalée (> 0 j), dont " & FORMAT ( COALESCE ( [Duration Alert Phases], 0 ), "0" ) & " atteignent +15 % de durée. " & FORMAT ( [Actual Deliverables], "#,0" ) & " livrables réalisés pour " & FORMAT ( [Planned Deliverables], "#,0" ) & " prévus. Les avances peuvent compenser les retards dans le cumul du projet." )
		displayFolder: Pilotage
		lineageTag: 13befff4-f562-4906-9509-8ed7555f1da1

	measure 'Detail Deadline Summary' =
			IF ( [Project Detail Available] = 1,
			"Début : " & FORMAT ( [Project Start], "dd/MM/yyyy" ) & "   •   Fin prévue : " & FORMAT ( [Project Planned Finish], "dd/MM/yyyy" ) & "   •   Fin calculée : " & FORMAT ( [Project Calculated Finish], "dd/MM/yyyy" ) & "   •   Décalage : " & FORMAT ( [Project Finish Variance Days], "+0;-0;0" ) & " j",
			"Une seule sélection est nécessaire pour afficher les échéances et les phases." )
		displayFolder: Pilotage
		lineageTag: 8b33d19c-228b-41e1-81e8-78655adc06a5

	measure 'Detail Country Rank' =
			VAR C = SELECTEDVALUE ( Dim_Project[Country] )
			VAR Countries = CALCULATETABLE ( VALUES ( Dim_Project[Country] ), REMOVEFILTERS ( Dim_Project ), REMOVEFILTERS ( Dim_Date ) )
			VAR Scores = ADDCOLUMNS ( Countries, "@Score", VAR CC = Dim_Project[Country] RETURN CALCULATE ( [Delay Exposure Days], REMOVEFILTERS ( Dim_Project ), REMOVEFILTERS ( Dim_Date ), TREATAS ( { CC }, Dim_Project[Country] ) ) )
			VAR CurrentScore = MAXX ( FILTER ( Scores, Dim_Project[Country] = C ), [@Score] )
			RETURN IF ( [Project Detail Available] = 1 && NOT ISBLANK ( CurrentScore ), C & " : " & FORMAT ( RANKX ( FILTER ( Scores, NOT ISBLANK ( [@Score] ) ), [@Score], CurrentScore, DESC, DENSE ), "0" ) & " / " & FORMAT ( COUNTROWS ( FILTER ( Scores, NOT ISBLANK ( [@Score] ) ) ), "0" ) )
		displayFolder: Pilotage
		lineageTag: 764a70af-c8d4-48c7-ac20-83df0a2addfc

	measure 'Detail Deliverables Summary' = IF ( [Project Detail Available] = 1, FORMAT ( [Actual Deliverables], "#,0" ) & " / " & FORMAT ( [Planned Deliverables], "#,0" ) & " livrables réalisés / prévus", "Aucun projet sélectionné" )
		displayFolder: Pilotage
		lineageTag: fbf46394-cde0-4fcb-ab87-338ce64fb86b

	measure 'Project Start' = IF ( HASONEVALUE ( Dim_Project[Project_ID] ), SELECTEDVALUE ( Dim_Project[Project_Start_Date] ) )
		formatString: dd/MM/yyyy
		displayFolder: Pilotage
		lineageTag: 49b1a96b-383e-4686-94ce-49992c261fd6

	measure 'Project Planned Finish' = IF ( HASONEVALUE ( Dim_Project[Project_ID] ), SELECTEDVALUE ( Dim_Project[Project_Planned_End_Date] ) )
		formatString: dd/MM/yyyy
		displayFolder: Pilotage
		lineageTag: 7a3edb03-7292-4cf0-95d7-0ee19a811c55

	measure 'Project Finish Variance Days' = VAR P = [Project Planned Finish] VAR A = [Project Calculated Finish] RETURN IF ( NOT ISBLANK ( P ) && NOT ISBLANK ( A ), DATEDIFF ( P, A, DAY ) )
		formatString: +0;-0;0
		displayFolder: Pilotage
		lineageTag: a59cbcdd-9623-4024-a43c-fba7539e2987

	measure 'Project Calculated Finish' = IF ( HASONEVALUE ( Dim_Project[Project_ID] ), SELECTEDVALUE ( Dim_Project[Project_Actual_End_Date_Derived] ) )
		formatString: dd/MM/yyyy
		displayFolder: Pilotage
		lineageTag: 7dbc8f70-14e4-4c67-bf1c-637d94c7faa4

	measure 'Planning Last Finish' = MAX ( Dim_Project[Project_Planned_End_Date] )
		formatString: dd/MM/yyyy
		displayFolder: Pilotage
		lineageTag: d84763a2-9b7c-4eb2-9a28-a3b1bb15f616

	measure 'Planning First Start' = MIN ( Dim_Project[Project_Start_Date] )
